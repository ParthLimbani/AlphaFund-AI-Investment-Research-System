# Copy this file to .env and fill in your keys

# LLM Providers (free tiers)
GROQ_API_KEY=your_groq_key_here          # https://console.groq.com
GOOGLE_API_KEY=your_google_key_here      # https://aistudio.google.com

# Financial News
NEWSAPI_KEY=your_newsapi_key_here        # https://newsapi.org (free: 100 req/day)

# SEC EDGAR (free — synthetic name is fine, SEC just needs something in the header)
SEC_USER_AGENT=AlphaBot admin@alphabot.com

# Local storage paths (defaults work fine, override if needed)
CHROMA_PERSIST_DIR=./data/chroma_db
SQLITE_DB_PATH=./data/episodic_memory.db
SEC_FILINGS_DIR=./data/sec_filings
